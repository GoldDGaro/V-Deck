{
  "name": "v-deck",
  "version": "0.1.0",
  "description": "Universal VPN manager for Steam Deck and Decky Loader",
  "type": "module",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "format:check": "prettier --check src package.json plugin.json rollup.config.js tsconfig.json eslint.config.js",
    "format": "prettier --write src package.json plugin.json rollup.config.js tsconfig.json eslint.config.js"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "react-icons": "5.7.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.12.0",
    "@rollup/rollup-linux-x64-musl": "4.63.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "rollup": "4.63.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
