diff --git a/src/openvpn/ssl_openssl.c b/src/openvpn/ssl_openssl.c
index d796627..9385a87 100644
--- a/src/openvpn/ssl_openssl.c
+++ b/src/openvpn/ssl_openssl.c
@@ -317,8 +317,10 @@ cert_verify_callback(X509_STORE_CTX *ctx, void *arg)
     session = SSL_get_ex_data(ssl, mydata_index);
     ASSERT(session);
 
-    /* Configure CRLs. */
+    /* Configure CRLs. wolfSSL 5.9.2 loads them into the certificate store. */
+#ifndef ENABLE_CRYPTO_WOLFSSL
     X509_STORE_CTX_set0_crls(ctx, session->opt->ssl_ctx->crls);
+#endif
     return X509_verify_cert(ctx);
 }
 
@@ -1456,6 +1458,12 @@ backend_tls_ctx_reload_crl(struct tls_root_ctx *ssl_ctx, const char *crl_file, b
         {
             crypto_msg(M_FATAL, "CRL: cannot add CRL to list");
         }
+#ifdef ENABLE_CRYPTO_WOLFSSL
+        if (X509_STORE_add_crl(store, crl) != 1)
+        {
+            crypto_msg(M_FATAL, "CRL: cannot add CRL to wolfSSL certificate store");
+        }
+#endif
         num_crls_loaded++;
     }
     msg(M_INFO, "CRL: loaded %d CRLs from file %s", num_crls_loaded, crl_file);
